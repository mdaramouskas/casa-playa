# ── App ────────────────────────────────────────────────────────────────
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# ── Database (Postgres / Supabase) ─────────────────────────────────────
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
# PGSSLMODE: require | verify-full | no-verify (dev with self-signed)
PGSSLMODE="require"
# DATABASE_POOL_MAX=1

# ── Admin/staff auth ───────────────────────────────────────────────────
# Secret used to sign staff session JWTs (jose). Generate: openssl rand -hex 32
AUTH_SECRET="change-me-in-production"

# ── Paycenter Redirection (Piraeus / epay eCommerce) ───────────────────
# mode: mock (no bank yet) | sandbox | production
PAYCENTER_MODE="mock"
PAYCENTER_MERCHANT_ID=""
PAYCENTER_POS_ID=""
PAYCENTER_HASH_KEY=""
# SOAP IssueNewTicket endpoint (from bank technical consultant)
PAYCENTER_ISSUE_TICKET_URL=""
# Hosted payment page (pay.aspx)
PAYCENTER_PAY_PAGE_URL=""
# SALE (full non-refundable charge) | PREAUTH — confirm with bank
PAYCENTER_TRANSACTION_TYPE="SALE"
PAYCENTER_CURRENCY="EUR"
