// Casa Playa — booking system schema
// All monetary values are stored in integer cents and are VAT-inclusive (24%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────

enum ProductType {
  LOUNGER // ξαπλώστρα (per set)
  CABANA // Standard / VIP (per set)
  TABLE // restaurant table (per person, timed slots)
}

enum PricingUnit {
  PER_SET
  PER_PERSON
}

// What a TimeSlot means for a product.
enum SlotKind {
  ARRIVAL // beds: booking covers the whole day, the slot is only the arrival time
  RESERVATION // restaurant: the slot is the actual reservation time
}

enum BookingStatus {
  PENDING // created, awaiting payment
  PAID // payment confirmed via verified HMAC callback
  FAILED // payment failed/cancelled
  CANCELLED // cancelled by staff (still non-refundable per policy)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum TransactionType {
  SALE
  PREAUTH
}

enum StaffRole {
  ADMIN
  STAFF
}

// What a priced line of a booking represents.
enum BookingItemKind {
  SET // a lounger/cabana set (2 people)
  EXTRA_PERSON // the 3rd person on a sunbed set — an extra lounger at half price
  PERSON // a person on a per-person product (restaurant menus)
  TABLE // a table with no per-person charge
}

// ── Catalog ────────────────────────────────────────────────────────────

model Product {
  id      String      @id @default(cuid())
  type    ProductType
  subtype String? // "1st Row" | "2nd Row" | "3rd Row"
  slug    String      @unique
  // Listing/page title exactly as shown to the customer
  // (e.g. "Book a Seaside Sun Bed 2nd Row").
  title   String
  titleEn String?
  // Plain product name, used in carts/emails/admin ("Seaside Sun Bed 2nd Row").
  name    String
  nameEn  String?

  description   String?
  descriptionEn String?
  // "Περιλαμβάνονται στην τιμή" bullets.
  includes      String[] @default([])
  includesEn    String[] @default([])
  // Extra note shown under the description
  // (e.g. "Η κράτηση ισχύει για όλη την ημέρα").
  note          String?
  noteEn        String?
  imageUrl      String?

  // VAT-inclusive price of one unit: a set (loungers/cabanas) or one person
  // (restaurant menus — there the price lives on the variant). 0 = no charge.
  priceCents            Int
  currency              String      @default("EUR")
  pricingUnit           PricingUnit
  // Price of the extra (3rd) person on a sunbed set — one more lounger at half
  // the set price. null = no extra person allowed.
  extraPersonPriceCents Int?
  allowExtraPerson      Boolean     @default(false)
  // People covered by one unit: 2 per bed set, 10 per private table, 4 per
  // restaurant table. Units consumed = ceil(persons / personsPerUnit).
  personsPerUnit        Int         @default(2)
  maxPersons            Int?
  // A booking may split its people across variants (Seafood + Meat menu).
  allowMixedVariants    Boolean     @default(false)

  // Units bookable per day — sunbeds/cabanas, which are all-day.
  // null = no daily limit.
  dailyCapacity    Int?
  // Units bookable per time slot — restaurant tables. Shared across all
  // variants of the product. null = no per-slot limit.
  slotCapacity     Int?
  // How long one booking holds a unit, in minutes (tables: 150 = 2.5h). A slot
  // is free again once this has elapsed. null = holds the whole day.
  occupancyMinutes Int?

  minQty       Int      @default(1)
  maxQty       Int?
  requiresSlot Boolean  @default(false)
  slotKind     SlotKind @default(RESERVATION)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  variants  ProductVariant[]
  overrides AvailabilityOverride[]
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A bookable group inside a product page — rendered as the collapsible header
// above the slot grid ("Cabana Beach Bed", "Seafood Menu", "Meat Menu").
// Every product has at least one.
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  nameEn     String?
  // Per-person price when the variant is priced (Seafood 75€, Meat 70€).
  // null = use the product price.
  priceCents Int?
  active     Boolean @default(true)
  sortOrder  Int     @default(0)

  timeSlots TimeSlot[]
  bookings  Booking[]
  items     BookingItem[]

  @@unique([productId, name])
}

// Bookable half-hour slots of a variant.
model TimeSlot {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  time      String // "13:00", "13:30" (24h, local time)
  capacity  Int? // null = no per-slot limit, falls back to Product.dailyCapacity
  active    Boolean        @default(true)
  sortOrder Int            @default(0)

  @@unique([variantId, time])
}

// Per-date capacity override (e.g. closed day = 0, or special count).
model AvailabilityOverride {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  capacity  Int // total capacity for that date (0 = closed)

  @@unique([productId, date])
}

// ── Bookings ───────────────────────────────────────────────────────────

model Booking {
  id        String  @id @default(cuid())
  reference String  @unique // CAPL.XXXXXXXXXX
  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantName String? // snapshot, e.g. "Seafood Menu"

  bookingDate  DateTime @db.Date // date of use (X)
  timeSlot     String? // "13:00" — arrival time (beds) or reservation time (tables)
  persons      Int // people on the booking
  // Units held against capacity: bed sets, or tables. The extra (3rd) person on
  // a sunbed rides along on the same set and does not consume one.
  units        Int      @default(1)
  extraPersons Int      @default(0)

  unitPriceCents Int // snapshot, VAT-inclusive
  subtotalCents  Int // sum of the item lines, before discount
  discountCents  Int     @default(0)
  totalCents     Int // locked amount actually charged
  currency       String  @default("EUR")
  couponCode     String?

  // Customer details
  firstName    String
  lastName     String
  email        String
  phone        String
  phoneCountry String? // dial code, e.g. "+30"
  comments     String?

  cancellationAccepted Boolean @default(false)

  status              BookingStatus @default(PENDING)
  rescheduleCount     Int           @default(0)
  originalBookingDate DateTime?     @db.Date // first date before any reschedule

  payment Payment?
  items   BookingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingDate])
  @@index([status])
  @@index([email])
}

// One priced line of a booking: "2 sets", "1 extra lounger", "4 × Seafood
// Menu". A single restaurant booking may mix menus, hence the separate rows.
model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  kind           BookingItemKind
  label          String // snapshot, e.g. "Seafood Menu"
  quantity       Int // sets, extra loungers or people
  unitPriceCents Int
  totalCents     Int

  @@index([bookingId])
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  provider        String          @default("paycenter")
  transactionType TransactionType @default(SALE)
  amountCents     Int
  currency        String          @default("EUR")
  status          PaymentStatus   @default(PENDING)

  // TranTicket from the ticketing WS. SECRET: it is the HMAC key that signs the
  // gateway's response, so it must never be sent to the browser.
  ticket     String?
  // `Parameters` — echoed back by the gateway and part of the signed message.
  parameters String?

  // Response fields (Redirection Manual §5). SupportReferenceID is the value
  // Euronet support asks for, and ApprovalCode is what the customer is shown.
  supportReferenceId  String?
  transactionId       String? // TransactionId, generated by epay eCommerce
  approvalCode        String? // ApprovalCode, only on an approved transaction
  paymentRef          String? // RetrievalRef (RRN) from the acquiring system
  responseCode        String? // 00/08/10/16 = approved
  responseDescription String?
  authStatus          String? // 3D Secure outcome: 01 success, 03 failure
  packageNo           String?
  cardType            String? // 1 Visa, 2 Mastercard, 3 Maestro, 15 IRIS …
  paymentMethod       String? // Card | IRIS
  traceId             String? // scheme reference, needed for recurring charges

  hmacVerified Boolean   @default(false)
  rawCallback  Json? // full verified response payload for audit
  processedAt  DateTime? // set once a response has been applied (idempotency)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([supportReferenceId])
}

// ── Discounts ──────────────────────────────────────────────────────────

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int? // 0-100
  amountOffCents Int? // fixed discount, VAT-inclusive
  active         Boolean   @default(true)
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Staff / admin ──────────────────────────────────────────────────────

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         StaffRole @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Business settings (identity, policy text, etc.) ────────────────────

model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt
}
