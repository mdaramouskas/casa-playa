// Casa Playa — booking system schema
// All monetary values are stored in integer cents and are VAT-inclusive (24%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────

enum ProductType {
  LOUNGER // ξαπλώστρα (per set)
  CABANA // Standard / VIP (per set)
  TABLE // restaurant table (per person, timed slots)
}

enum PricingUnit {
  PER_SET
  PER_PERSON
}

// What a TimeSlot means for a product.
enum SlotKind {
  ARRIVAL // beds: booking covers the whole day, the slot is only the arrival time
  RESERVATION // restaurant: the slot is the actual reservation time
}

enum BookingStatus {
  PENDING // created, awaiting payment
  PAID // payment confirmed via verified HMAC callback
  FAILED // payment failed/cancelled
  CANCELLED // cancelled by staff (still non-refundable per policy)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum TransactionType {
  SALE
  PREAUTH
}

enum StaffRole {
  ADMIN
  STAFF
}

// ── Catalog ────────────────────────────────────────────────────────────

model Product {
  id      String      @id @default(cuid())
  type    ProductType
  subtype String? // "1st Row" | "2nd Row" | "3rd Row"
  slug    String      @unique
  // Listing/page title exactly as shown to the customer
  // (e.g. "Book a Seaside Sun Bed 2nd Row").
  title   String
  titleEn String?
  // Plain product name, used in carts/emails/admin ("Seaside Sun Bed 2nd Row").
  name    String
  nameEn  String?

  description   String?
  descriptionEn String?
  // "Περιλαμβάνονται στην τιμή" bullets.
  includes      String[] @default([])
  includesEn    String[] @default([])
  // Extra note shown under the description
  // (e.g. "Η κράτηση ισχύει για όλη την ημέρα").
  note          String?
  noteEn        String?
  imageUrl      String?

  priceCents    Int // VAT-inclusive unit price (0 = no prepayment / price not shown)
  currency      String      @default("EUR")
  pricingUnit   PricingUnit
  // Units available per day: "sets" for loungers/cabanas, "seats" for tables.
  // null = not configured yet (no limit enforced).
  dailyCapacity Int?
  minQty        Int         @default(1)
  maxQty        Int?
  requiresSlot  Boolean     @default(false)
  slotKind      SlotKind    @default(RESERVATION)
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)

  variants  ProductVariant[]
  overrides AvailabilityOverride[]
  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A bookable group inside a product page — rendered as the collapsible header
// above the slot grid ("Cabana Beach Bed", "Seafood Menu", "Meat Menu").
// Every product has at least one.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  nameEn    String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  timeSlots TimeSlot[]
  bookings  Booking[]

  @@unique([productId, name])
}

// Bookable half-hour slots of a variant.
model TimeSlot {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  time      String // "13:00", "13:30" (24h, local time)
  capacity  Int? // null = no per-slot limit, falls back to Product.dailyCapacity
  active    Boolean        @default(true)
  sortOrder Int            @default(0)

  @@unique([variantId, time])
}

// Per-date capacity override (e.g. closed day = 0, or special count).
model AvailabilityOverride {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  capacity  Int // total capacity for that date (0 = closed)

  @@unique([productId, date])
}

// ── Bookings ───────────────────────────────────────────────────────────

model Booking {
  id        String  @id @default(cuid())
  reference String  @unique // CAPL.XXXXXXXXXX
  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantName String? // snapshot, e.g. "Seafood Menu"

  bookingDate    DateTime @db.Date // date of use (X)
  timeSlot       String? // "13:00" — arrival time (beds) or reservation time (tables)
  quantity       Int // sets or persons
  unitPriceCents Int // snapshot, VAT-inclusive
  subtotalCents  Int // unit * qty before discount
  discountCents  Int      @default(0)
  totalCents     Int // locked amount actually charged
  currency       String   @default("EUR")
  couponCode     String?

  // Customer details
  firstName    String
  lastName     String
  email        String
  phone        String
  phoneCountry String? // dial code, e.g. "+30"
  comments     String?

  cancellationAccepted Boolean @default(false)

  status              BookingStatus @default(PENDING)
  rescheduleCount     Int           @default(0)
  originalBookingDate DateTime?     @db.Date // first date before any reschedule

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingDate])
  @@index([status])
  @@index([email])
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  provider        String          @default("paycenter")
  transactionType TransactionType @default(SALE)
  amountCents     Int
  currency        String          @default("EUR")
  status          PaymentStatus   @default(PENDING)

  ticket        String? // Paycenter ticket from IssueNewTicket
  transactionId String? // bank transaction id (from callback)
  paymentRef    String? // bank reference / RRN
  hmacVerified  Boolean   @default(false)
  rawCallback   Json? // full verified callback payload for audit
  processedAt   DateTime? // set once a callback has been applied (idempotency)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
}

// ── Discounts ──────────────────────────────────────────────────────────

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int? // 0-100
  amountOffCents Int? // fixed discount, VAT-inclusive
  active         Boolean   @default(true)
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Staff / admin ──────────────────────────────────────────────────────

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         StaffRole @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Business settings (identity, policy text, etc.) ────────────────────

model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt
}
