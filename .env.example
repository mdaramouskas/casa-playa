# ── App ────────────────────────────────────────────────────────────────
# Absolute base URL, used to build the payment redirect + callback URLs.
# On Vercel it falls back to the deployment URL when unset.
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# ── Database (Postgres / Supabase) ─────────────────────────────────────
# Supabase pooler, transaction mode (port 6543). The user is
# "<db-role>.<project-ref>". The app uses a dedicated `casa_playa_app` role,
# not the project's postgres superuser.
DATABASE_URL="postgresql://casa_playa_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# PGSSLMODE: require | verify-full | no-verify.
# Supabase's pooler presents a self-signed chain, so "no-verify" is required.
PGSSLMODE="no-verify"
# DATABASE_POOL_MAX=1

# Same database over the SESSION pooler (port 5432). Used by the Prisma CLI
# only — `db push`, `migrate` and `studio` issue DDL and need prepared
# statements, which the transaction pooler (6543) does not support, so they
# hang there. Not needed on Vercel; the app itself only uses DATABASE_URL.
DIRECT_URL="postgresql://casa_playa_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Admin/staff auth ───────────────────────────────────────────────────
# Secret used to sign staff session JWTs (jose). Generate: openssl rand -hex 32
AUTH_SECRET="change-me-in-production"

# ── Paycenter Redirection (Piraeus / epay eCommerce) ───────────────────
# mode: mock (no account yet) | test | live.
# There is NO separate sandbox host: test and live use the same endpoints and
# differ only in the five credentials below, which Euronet issues twice.
PAYCENTER_MODE="mock"
PAYCENTER_ACQUIRER_ID=""
PAYCENTER_MERCHANT_ID=""
PAYCENTER_POS_ID=""
PAYCENTER_USERNAME=""
# Plaintext — the app MD5-hashes it before calling the ticketing WS.
PAYCENTER_PASSWORD=""

# Endpoints default to the documented production ones; override only if Euronet
# gives different ones.
# PAYCENTER_ISSUE_TICKET_URL="https://paycenter.piraeusbank.gr/services/tickets/issuer.asmx"
# PAYCENTER_PAY_PAGE_URL="https://paycenter.piraeusbank.gr/redirection/pay.aspx"
# SOAP operation + namespace — CONFIRM against ${PAYCENTER_ISSUE_TICKET_URL}?WSDL
# PAYCENTER_SOAP_METHOD="IssueNewTicket"
# PAYCENTER_SOAP_NAMESPACE="http://piraeusbank.gr/paycenter/redirection"

# SALE = RequestType 02 (charged immediately) | PREAUTH = 00 (needs Euronet
# approval, plus a later completion step). The brief's no-refund policy fits SALE.
PAYCENTER_TRANSACTION_TYPE="SALE"
PAYCENTER_CURRENCY="EUR"
# ISO-4217 numeric, 978 = EUR. A different currency needs its own MerchantId/PosId.
PAYCENTER_CURRENCY_CODE="978"
# Preauth only: exactly 30 while testing, 2–30 live.
PAYCENTER_EXPIRE_PREAUTH_DAYS="30"
